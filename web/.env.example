# Since .env is gitignored, copy this file to .env and fill in the values.
# Duplicating it here keeps every web-process variable in one place; adding a
# new one means adding it to src/env.js and to this file.

# Better Auth. BETTER_AUTH_URL is the browser-facing origin, so on the compose
# stack it is the published port (http://localhost:3300), not the service name.
# The secret must be at least 32 characters and rotating it signs every live
# browser session out. Generate one with `openssl rand -base64 32`.
BETTER_AUTH_URL="http://localhost:3000"
BETTER_AUTH_SECRET="dev-better-auth-secret-change-me-32chars"

# Keycloak. Optional: leave unset and the branded sign-in form answers
# "No identity realm is configured", which is the local dev-token shape. The
# form posts to /api/auth/login, which runs the password grant against
# KEYCLOAK_ISSUER server-side, so the realm's redsim-web client needs Direct
# access grants enabled. The compose realm's client is public, so
# KEYCLOAK_CLIENT_SECRET stays empty there; the deployed realm's client is
# confidential and needs it.
# KEYCLOAK_ISSUER="http://localhost:8080/realms/redsim"
# KEYCLOAK_CLIENT_ID="redsim-web"
# The issuer as the browser reaches it, when it differs from KEYCLOAK_ISSUER.
# KEYCLOAK_PUBLIC_ISSUER="http://localhost:8080/realms/redsim"
# KEYCLOAK_CLIENT_SECRET=""

# Redsim session cookie contract. FastAPI verifies redsim_api_session against
# the public half of this key, so the two sides must agree. Operator-supplied:
# no keypair is committed. Generate one with
# `openssl genpkey -algorithm RSA -pkeyopt rsa_keygen_bits:2048`.
# REDSIM_API_SESSION_PRIVATE_KEY=""
# REDSIM_API_SESSION_KEY_ID="redsim-api-session-v1"
# REDSIM_API_SESSION_TTL_SECONDS="900"
# REDSIM_API_SESSION_COOKIE="redsim_api_session"
# REDSIM_CSRF_COOKIE="redsim_csrf"

# Anything other than "prod" keeps the dev-token login path visible and leaves
# the Secure attribute off both redsim cookies. It is also the server-side
# authority for the dev-token cookie and for fixture mode: only "dev" and
# "test" honour either, and an unset value reads as "dev".
REDSIM_ENV="dev"

# Where the Next server reaches FastAPI. Server-only: the browser never sees
# it, so changing where the API lives no longer rebuilds the web image. On the
# compose stack this is the service name, not the published port.
REDSIM_API_URL="http://localhost:8000"

# Name of the non-httpOnly cookie the dev-token login writes. The browser reads
# it for the WebSocket subprotocol; the server turns it into a bearer, and only
# when REDSIM_ENV is dev or test.
# REDSIM_DEV_TOKEN_COOKIE="redsim_dev_token"

# Answer browser data calls from web/src/__fixtures__ instead of the API. The
# server flag is the runtime authority; the public one paints the ribbon and is
# the build-time branch that decides whether the fixture module is bundled at
# all. Either flag with REDSIM_ENV outside dev or test fails validation at boot
# and at build.
# REDSIM_DEV_FIXTURES="1"
# NEXT_PUBLIC_REDSIM_DEV_FIXTURES="1"

# Browser-visible mirrors. Next inlines these at build time. There is no client
# name for the session cookie: it is httpOnly, so JavaScript cannot read it.
NEXT_PUBLIC_REDSIM_API_URL="http://localhost:8000"
NEXT_PUBLIC_REDSIM_ENV="dev"
NEXT_PUBLIC_REDSIM_CSRF_COOKIE="redsim_csrf"
NEXT_PUBLIC_REDSIM_CSRF_HEADER="X-Redsim-CSRF"

# Build-time escape hatch only. Set in the Docker builder stage and the CI
# build step, where no runtime value exists yet. It returns the raw
# environment, so no default above applies. Never set it at run time.
# SKIP_ENV_VALIDATION="1"
