# Since .env is gitignored, copy this file to .env and fill in the values.
# Duplicating it here keeps every web-process variable in one place; adding a
# new one means adding it to src/env.js and to this file.

# The web process. REDSIM_WEB_ORIGIN is the browser-facing origin, so on the
# compose stack it is the published port (http://localhost:3300), not the
# service name. The secret seals the refresh cookie and signs the sign-out hop
# token; it must be at least 32 characters and rotating it signs every browser
# out. Generate one with `openssl rand -base64 32`. The retired names
# BETTER_AUTH_URL and BETTER_AUTH_SECRET are still read as fallbacks.
REDSIM_WEB_ORIGIN="http://localhost:3000"
REDSIM_WEB_SESSION_SECRET="dev-web-session-secret-change-me-32chars"

# The identity realm the login page signs in against. The login route posts
# the email and password to its token endpoint from the server (the password
# grant; the realm client needs direct access grants on). Leave unset and the
# app boots but the login page answers "sign-in is not available".
# The compose realm's redsim-web is a public client, so the secret stays empty
# there; the EC2 realm's is confidential and carries one.
KEYCLOAK_ISSUER="http://localhost:8080/realms/redsim"
KEYCLOAK_CLIENT_ID="redsim-web"
# The issuer as the browser reaches it, when it differs from KEYCLOAK_ISSUER.
# Tokens stamped with either spelling are accepted.
# KEYCLOAK_PUBLIC_ISSUER="http://localhost:8080/realms/redsim"
# KEYCLOAK_CLIENT_SECRET=""

# Redsim session cookie contract. FastAPI verifies redsim_api_session against
# the public half of this key, so the two sides must agree. Operator-supplied:
# no keypair is committed. Generate one with
# `openssl genpkey -algorithm RSA -pkeyopt rsa_keygen_bits:2048`.
# REDSIM_API_SESSION_PRIVATE_KEY=""
# REDSIM_API_SESSION_KEY_ID="redsim-api-session-v1"
# REDSIM_API_SESSION_TTL_SECONDS="900"
# REDSIM_API_SESSION_COOKIE="redsim_api_session"
# REDSIM_CSRF_COOKIE="redsim_csrf"

# Anything other than "prod" leaves the Secure attribute off the redsim
# cookies. It is also the server-side authority for fixture mode: only "dev"
# and "test" honour it, and an unset value reads as "dev". There is no dev
# login: the only way in is the login page against the realm above.
REDSIM_ENV="dev"

# Where the Next server reaches FastAPI. Server-only: the browser never sees
# it, so changing where the API lives no longer rebuilds the web image. On the
# compose stack this is the service name, not the published port.
REDSIM_API_URL="http://localhost:8000"

# Name of the httpOnly cookie that holds the sealed refresh token, scoped to
# /api/auth. Only the refresh and sign-out routes read it.
# REDSIM_REFRESH_COOKIE="redsim_refresh"

# Answer browser data calls from web/src/__fixtures__ instead of the API. The
# server flag is the runtime authority; the public one paints the ribbon and is
# the build-time branch that decides whether the fixture module is bundled at
# all. Either flag with REDSIM_ENV outside dev or test fails validation at boot
# and at build.
# REDSIM_DEV_FIXTURES="1"
# NEXT_PUBLIC_REDSIM_DEV_FIXTURES="1"

# Browser-visible mirrors. Next inlines these at build time. There is no client
# name for the session cookie: it is httpOnly, so JavaScript cannot read it.
NEXT_PUBLIC_REDSIM_API_URL="http://localhost:8000"
NEXT_PUBLIC_REDSIM_ENV="dev"
NEXT_PUBLIC_REDSIM_CSRF_COOKIE="redsim_csrf"
NEXT_PUBLIC_REDSIM_CSRF_HEADER="X-Redsim-CSRF"

# Build-time escape hatch only. Set in the Docker builder stage and the CI
# build step, where no runtime value exists yet. It returns the raw
# environment, so no default above applies. Never set it at run time.
# SKIP_ENV_VALIDATION="1"

# The finding chat (the "Chat" drawer on /findings/[id]) talks to the Pythia
# gateway from this process with the same names the Python services read
# (docs/ops/pythia.md). All optional: without a base URL and a key the panel
# says chat is unavailable. The key never reaches the browser. Behind a
# corporate TLS proxy Node needs the root through NODE_EXTRA_CA_CERTS.
# PYTHIA_BASE_URL=""
# PYTHIA_API_KEY=""
# PYTHIA_PERSONA=""
# Seconds before a gateway request is aborted, the whole streamed answer
# included (default 120).
# PYTHIA_TIMEOUT_S="120"
# Canonical Pythia model id the chat sends (default anthropic/claude-opus-5).
# REDSIM_WEB_CHAT_MODEL="anthropic/claude-opus-5"
