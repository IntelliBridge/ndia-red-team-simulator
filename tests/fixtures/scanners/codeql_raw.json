{
  "$schema": "https://json.schemastore.org/sarif-2.1.0.json",
  "version": "2.1.0",
  "runs": [
    {
      "tool": {
        "driver": {
          "name": "CodeQL",
          "version": "2.16.0"
        }
      },
      "results": [
        {
          "ruleId": "py/sql-injection",
          "level": "error",
          "message": {
            "text": "This query depends on a user-provided value."
          },
          "locations": [
            {
              "physicalLocation": {
                "artifactLocation": {
                  "uri": "app/db.py"
                },
                "region": {
                  "startLine": 42,
                  "endLine": 45
                }
              }
            }
          ]
        },
        {
          "ruleId": "py/clear-text-logging-sensitive-data",
          "level": "warning",
          "message": {
            "text": "Sensitive data is logged in clear text."
          },
          "locations": [
            {
              "physicalLocation": {
                "artifactLocation": {
                  "uri": "app/auth.py"
                },
                "region": {
                  "startLine": 18,
                  "endLine": 18
                }
              }
            }
          ]
        }
      ]
    }
  ]
}
