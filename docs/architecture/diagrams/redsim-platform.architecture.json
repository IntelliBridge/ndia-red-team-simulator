  "cards": [
    {
      "dot": "cyan",
      "title": "Campaign path",
      "items": [
        "Admission (redsim/services/scans.py): audit row, then Run + Job rows, then task.delay",
        "Worker (redsim/workers/bootstrap.py, events.py): records, artifacts, events relayed by redsim/api/ws.py"
      ]
    },
    {
      "dot": "rose",
      "title": "Trust boundaries",
      "items": [
        "Keycloak issues OIDC tokens, the API verifies them against JWKS (redsim/api/auth.py), Postgres RLS via the tenant GUC",
        "Pythia is the only LLM egress and gets text only (redsim/llm/pythia.py), the audit chain is exported to WORM (redsim/storage/worm.py)"
      ]
    },
    {
      "dot": "amber",
      "title": "Planned and opt-in",
      "items": [
        "Planned, not on main at 4320740: sandbox child (D2), /v1/models routes, attack.run, explain.run, harden.recommend tasks",
        "redsim ml build-assets is a stub (redsim/cli/ml.py), the obs profile services are opt-in (deploy/docker-compose.yml)"
      ]
    }
