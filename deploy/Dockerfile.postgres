FROM postgres:16

# pgaudit logs DDL + role/GRANT changes out-of-band, so any attempt to disable
# the audit_events append-only controls (DROP TRIGGER, ALTER ROLE, GRANT) is
# itself recorded. The stock postgres image doesn't ship the extension; install
# it from the PGDG repo already configured in the base image.
#
# Extra CA trust (Zscaler / corporate proxy) before apt hits the network. The
# deploy/certs/ dir may be empty off-corp; update-ca-certificates then no-ops.
#
# The PGDG source is fetched over https, and ca-certificates is installed from
# the Debian mirror first so that fetch can verify the server. Over plain http
# the Docker Desktop proxy (http.docker.internal:3128) hands apt a
# gzip-compressed InRelease for apt.postgresql.org, which apt rejects with
# "Clearsigned file isn't valid, got 'NOSPLIT'" and the build fails. The base
# image's pgdg.list is moved aside for the first update so that same fetch is
# never attempted before ca-certificates is present.
COPY deploy/certs/ /usr/local/share/ca-certificates/redsim-extra/
RUN mv /etc/apt/sources.list.d/pgdg.list /tmp/pgdg.list \
    && apt-get update \
    && apt-get install -y --no-install-recommends ca-certificates \
    && sed 's#http://apt.postgresql.org#https://apt.postgresql.org#' /tmp/pgdg.list \
         > /etc/apt/sources.list.d/pgdg.list \
    && rm /tmp/pgdg.list \
    && find /usr/local/share/ca-certificates/redsim-extra/ -type f \( -name "*.pem" -o -name "*.crt" \) \
         -exec sh -c 'cp "$1" "/usr/local/share/ca-certificates/$(basename "${1%.*}").crt"' _ {} \; \
    && update-ca-certificates \
    && apt-get update \
    && apt-get install -y --no-install-recommends postgresql-16-pgaudit \
    && rm -rf /var/lib/apt/lists/*

# pgaudit must be preloaded and its log classes set. Migration 0004 runs
# CREATE EXTENSION + ALTER ROLE pgaudit.log; these server-level settings are
# the operator-layer half that can't live in a migration transaction.
CMD ["postgres", "-c", "shared_preload_libraries=pgaudit", "-c", "pgaudit.log=ddl, role"]
