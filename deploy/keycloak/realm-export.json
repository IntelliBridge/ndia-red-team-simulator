{
  "realm": "redsim",
  "enabled": true,
  "registrationAllowed": false,
  "ssoSessionIdleTimeout": 1800,
  "accessTokenLifespan": 600,
  "roles": {
    "realm": [
      {
        "name": "scanner"
      },
      {
        "name": "remediator"
      },
      {
        "name": "approver"
      },
      {
        "name": "admin"
      },
      {
        "name": "viewer",
        "description": "Read-only access to project evidence and reviewed findings (rank 0)"
      }
    ]
  },
  "users": [
    {
      "username": "admin",
      "email": "admin@redsim.local",
      "enabled": true,
      "emailVerified": true,
      "credentials": [
        {
          "type": "password",
          "value": "adminpass"
        }
      ],
      "realmRoles": [
        "admin"
      ]
    }
  ],
  "clients": [
    {
      "clientId": "redsim-web",
      "publicClient": true,
      "redirectUris": [
        "http://localhost:3000/*",
        "http://localhost:3300/*"
      ],
      "webOrigins": [
        "http://localhost:3000",
        "http://localhost:3300"
      ],
      "directAccessGrantsEnabled": true,
      "protocolMappers": [
        {
          "name": "redsim_project_roles",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-usermodel-attribute-mapper",
          "consentRequired": false,
          "config": {
            "user.attribute": "redsim_project_roles",
            "claim.name": "redsim_project_roles",
            "jsonType.label": "JSON",
            "id.token.claim": "true",
            "access.token.claim": "true",
            "userinfo.token.claim": "true",
            "multivalued": "false",
            "aggregate.attrs": "false"
          }
        }
      ]
    },
    {
      "clientId": "redsim-api",
      "publicClient": false,
      "bearerOnly": true,
      "secret": "redsim-api-dev-secret"
    }
  ]
}
