{
  "realm": "aegis",
  "enabled": true,
  "registrationAllowed": false,
  "ssoSessionIdleTimeout": 1800,
  "accessTokenLifespan": 600,
  "roles": {
    "realm": [
      {"name": "scanner"},
      {"name": "remediator"},
      {"name": "approver"},
      {"name": "admin"}
    ]
  },
  "users": [
    {
      "username": "admin",
      "email": "admin@aegis.local",
      "enabled": true,
      "emailVerified": true,
      "credentials": [{"type": "password", "value": "adminpass"}],
      "realmRoles": ["admin"]
    }
  ],
  "clients": [
    {
      "clientId": "aegis-web",
      "publicClient": true,
      "redirectUris": ["http://localhost:3000/*"],
      "webOrigins": ["http://localhost:3000"],
      "directAccessGrantsEnabled": true
    },
    {
      "clientId": "aegis-api",
      "publicClient": false,
      "bearerOnly": true,
      "secret": "aegis-api-dev-secret"
    }
  ]
}
