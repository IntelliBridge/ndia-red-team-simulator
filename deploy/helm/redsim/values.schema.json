{
  "$schema": "https://json-schema.org/draft-07/schema#",
  "title": "Redsim Helm chart values",
  "description": "Validates the Redsim chart values. The root is intentionally permissive (additionalProperties allowed) so this schema can grow incrementally; the security-sensitive config.secret block is validated strictly.",
  "type": "object",
  "additionalProperties": true,
  "properties": {
    "config": {
      "type": "object",
      "additionalProperties": true,
      "properties": {
        "env": {
          "type": "string",
          "description": "Deployment environment. 'prod' activates the dev-placeholder secret guard.",
          "enum": ["dev", "staging", "prod"]
        },
        "apiUrl": {
          "type": "string",
          "format": "uri",
          "minLength": 1,
          "description": "Server-only base URL the web pod's tRPC layer calls FastAPI on. In-cluster Service name, never a browser-facing origin, and never sent to a browser."
        },
        "webApiUrl": {
          "type": "string",
          "format": "uri",
          "minLength": 1,
          "description": "Browser-facing API origin. Read only by the run-events socket, artifact images and report links."
        },
        "secret": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "existingSecret",
            "s3AccessKeyId",
            "s3SecretAccessKey",
            "betterAuthSecret",
            "apiSessionPrivateKey",
            "apiSessionPublicKey",
            "externalSecrets"
          ],
          "properties": {
            "existingSecret": {
              "type": "string",
              "description": "Name of a pre-provisioned Secret to consume instead of rendering one. Empty string renders/sources the Secret in-chart."
            },
            "s3AccessKeyId": {
              "type": "string",
              "minLength": 1
            },
            "s3SecretAccessKey": {
              "type": "string",
              "minLength": 1
            },
            "betterAuthSecret": {
              "type": "string",
              "minLength": 32,
              "description": "Better Auth signing secret. At least 32 characters; rotating it invalidates every live browser session."
            },
            "apiSessionPrivateKey": {
              "type": "string",
              "description": "RS256 PKCS8 PEM whose public half FastAPI verifies redsim_api_session against. Operator-supplied; empty disables minting."
            },
            "apiSessionPublicKey": {
              "type": "string",
              "description": "SubjectPublicKeyInfo PEM matching apiSessionPrivateKey, read by the api as REDSIM_API_SESSION_PUBLIC_KEY. Empty means the api verifies no browser cookie."
            },
            "externalSecrets": {
              "type": "object",
              "additionalProperties": false,
              "required": ["enabled"],
              "properties": {
                "enabled": {
                  "type": "boolean",
                  "description": "Render an ExternalSecret sourced by the External Secrets Operator instead of templating secret values."
                },
                "secretStoreRef": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": ["name", "kind"],
                  "properties": {
                    "name": { "type": "string", "minLength": 1 },
                    "kind": {
                      "type": "string",
                      "enum": ["ClusterSecretStore", "SecretStore"]
                    }
                  }
                },
                "refreshInterval": {
                  "type": "string",
                  "minLength": 1
                },
                "data": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "additionalProperties": false,
                    "required": ["secretKey", "remoteRef"],
                    "properties": {
                      "secretKey": { "type": "string", "minLength": 1 },
                      "remoteRef": {
                        "type": "object",
                        "additionalProperties": false,
                        "required": ["key"],
                        "properties": {
                          "key": { "type": "string", "minLength": 1 },
                          "property": { "type": "string" }
                        }
                      }
                    }
                  }
                }
              }
            }
          }
        }
      }
    }
  }
}
