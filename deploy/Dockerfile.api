FROM python:3.14-slim AS base

ENV PYTHONDONTWRITEBYTECODE=1 PYTHONUNBUFFERED=1 PIP_NO_CACHE_DIR=1

WORKDIR /app

# Install extra CA trust (Zscaler / corporate proxy) BEFORE we hit pypi.
# The `deploy/certs/` directory may be empty on uncorporate networks; the
# COPY then no-ops because `update-ca-certificates` finds nothing to add.
COPY deploy/certs/ /usr/local/share/ca-certificates/redsim-extra/
RUN apt-get update && apt-get install -y --no-install-recommends \
        ca-certificates git \
    && find /usr/local/share/ca-certificates/redsim-extra/ -type f \( -name "*.pem" -o -name "*.crt" \) \
         -exec sh -c 'cp "$1" "/usr/local/share/ca-certificates/$(basename "${1%.*}").crt"' _ {} \; \
    && update-ca-certificates \
    && rm -rf /var/lib/apt/lists/*

ENV REQUESTS_CA_BUNDLE=/etc/ssl/certs/ca-certificates.crt \
    SSL_CERT_FILE=/etc/ssl/certs/ca-certificates.crt \
    PIP_CERT=/etc/ssl/certs/ca-certificates.crt

RUN pip install --upgrade pip

COPY pyproject.toml ./
COPY redsim ./redsim
COPY alembic.ini ./

# api + worker give the API its SQLAlchemy/alembic side and the Celery
# client it enqueues jobs with. The ml extra is NOT installed here: the API
# process never imports torch, ART, onnxruntime or SHAP and never opens a
# model file (spec sections 8.4 and 20.2). tests/test_api_process_has_no_ml.py
# enforces the boundary.
RUN pip install -e ".[api,worker]"

EXPOSE 8000
# Apply pending migrations (alembic.ini -> redsim/db/migrations, URL from
# REDSIM_DB_URL) and start the redsim FastAPI factory.
CMD ["sh", "-c", "alembic upgrade head && uvicorn redsim.api.app:create_app --factory --host 0.0.0.0 --port 8000"]
