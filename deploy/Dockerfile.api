FROM python:3.12-slim AS base

ENV PYTHONDONTWRITEBYTECODE=1 PYTHONUNBUFFERED=1 PIP_NO_CACHE_DIR=1

WORKDIR /app

# Install extra CA trust (Zscaler / corporate proxy) BEFORE we hit pypi.
# The `deploy/certs/` directory may be empty on uncorporate networks; the
# COPY then no-ops because `update-ca-certificates` finds nothing to add.
COPY deploy/certs/ /usr/local/share/ca-certificates/aegis-extra/
RUN apt-get update && apt-get install -y --no-install-recommends \
        ca-certificates git \
    && find /usr/local/share/ca-certificates/aegis-extra/ -type f \( -name "*.pem" -o -name "*.crt" \) \
         -exec sh -c 'cp "$1" "/usr/local/share/ca-certificates/$(basename "${1%.*}").crt"' _ {} \; \
    && update-ca-certificates \
    && rm -rf /var/lib/apt/lists/*

ENV REQUESTS_CA_BUNDLE=/etc/ssl/certs/ca-certificates.crt \
    SSL_CERT_FILE=/etc/ssl/certs/ca-certificates.crt \
    PIP_CERT=/etc/ssl/certs/ca-certificates.crt

COPY pyproject.toml ./
COPY aegis ./aegis
COPY alembic.ini ./

RUN pip install --upgrade pip && pip install -e ".[api,worker]"

EXPOSE 8000
CMD ["sh", "-c", "alembic upgrade head && uvicorn aegis.api.app:create_app --factory --host 0.0.0.0 --port 8000"]
