FROM python:3.14-slim

ENV PYTHONDONTWRITEBYTECODE=1 PYTHONUNBUFFERED=1 PIP_NO_CACHE_DIR=1

WORKDIR /app

COPY deploy/certs/ /usr/local/share/ca-certificates/redsim-extra/
RUN apt-get update && apt-get install -y --no-install-recommends \
        ca-certificates git curl \
    && find /usr/local/share/ca-certificates/redsim-extra/ -type f \( -name "*.pem" -o -name "*.crt" \) \
         -exec sh -c 'cp "$1" "/usr/local/share/ca-certificates/$(basename "${1%.*}").crt"' _ {} \; \
    && update-ca-certificates \
    && rm -rf /var/lib/apt/lists/*

ENV REQUESTS_CA_BUNDLE=/etc/ssl/certs/ca-certificates.crt \
    SSL_CERT_FILE=/etc/ssl/certs/ca-certificates.crt \
    PIP_CERT=/etc/ssl/certs/ca-certificates.crt

# Install the CPU-only torch/torchvision first, so the ART/SHAP stack that
# the ml extra resolves reuses them instead of pulling the multi-GB CUDA
# wheels. Attacks run on CPU (see the spec: no GPU).
RUN pip install --upgrade pip && \
    pip install --index-url https://download.pytorch.org/whl/cpu \
        "torch>=2.3" "torchvision>=0.18"

COPY pyproject.toml ./
COPY redsim ./redsim

# This image runs the attacks, so it carries the ml extra (torch, ART,
# SHAP, onnxruntime, scikit-learn) on top of the Celery worker deps. The api
# extra is here too: the campaign task imports redsim.services.reports and
# redsim.services.ml_campaigns, which raise the spec 17.3 codes from
# redsim.api.errors, and importing that package needs fastapi. Without it
# every redsim.ml_campaign_run ended at pickup with ModuleNotFoundError.
# The reverse boundary (no torch, ART, onnxruntime or SHAP in the api image)
# is unchanged and still pinned by tests/test_api_process_has_no_ml.py.
# The garak extra rides along because redsim.ml_llm_probe_run spawns the probe
# child in this image; without it a probe job dies at pickup on import garak.
RUN pip install -e ".[api,worker,ml,garak]"

# A standalone worker consumes both queues so nothing is stranded; the compose
# stack overrides this to run a dedicated pool per queue (-Q scans / -Q default)
# plus a beat scheduler. See deploy/docker-compose.yml.
CMD ["celery", "-A", "redsim.workers.celery_app", "worker", "-Q", "scans,default", "--loglevel=info"]
