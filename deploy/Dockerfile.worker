FROM python:3.12-slim

ENV PYTHONDONTWRITEBYTECODE=1 PYTHONUNBUFFERED=1 PIP_NO_CACHE_DIR=1

WORKDIR /app

COPY deploy/certs/ /usr/local/share/ca-certificates/aegis-extra/
RUN apt-get update && apt-get install -y --no-install-recommends \
        ca-certificates git curl \
    && find /usr/local/share/ca-certificates/aegis-extra/ -type f \( -name "*.pem" -o -name "*.crt" \) \
         -exec sh -c 'cp "$1" "/usr/local/share/ca-certificates/$(basename "${1%.*}").crt"' _ {} \; \
    && update-ca-certificates \
    && rm -rf /var/lib/apt/lists/*

ENV REQUESTS_CA_BUNDLE=/etc/ssl/certs/ca-certificates.crt \
    SSL_CERT_FILE=/etc/ssl/certs/ca-certificates.crt \
    PIP_CERT=/etc/ssl/certs/ca-certificates.crt

COPY pyproject.toml ./
COPY aegis ./aegis
# project_repos/ is optional in the build context — when the submodules
# haven't been initialised the worker still runs (subprocesses + golden
# patch path). We `|| true` the editable installs so the image build is
# tolerant of partial submodule state.
COPY project_repos/ ./project_repos/

RUN pip install --upgrade pip && pip install -e ".[worker]" && \
    ( [ -d project_repos/strix ] && pip install -e project_repos/strix || true ) && \
    ( [ -d project_repos/cai ]   && pip install -e project_repos/cai   || true ) && \
    ( git -C project_repos/strix rev-parse HEAD > /app/STRIX.sha 2>/dev/null || true ) && \
    ( git -C project_repos/cai   rev-parse HEAD > /app/CAI.sha   2>/dev/null || true )

# A standalone worker consumes both queues so nothing is stranded; the compose
# stack overrides this to run a dedicated pool per queue (-Q scans / -Q default)
# plus a beat scheduler. See deploy/docker-compose.yml.
CMD ["celery", "-A", "aegis.workers.celery_app", "worker", "-Q", "scans,default", "--loglevel=info"]
