# Dockerfile for @redsim/web (Next.js 14).
#
# Builds against the pnpm workspace at the repo root, so @redsim/web and
# @redsim/design-system are linked the same way they are in dev.
# ``docker build`` MUST be invoked from the repo root with
# ``-f deploy/Dockerfile.web .``.

FROM node:26-bookworm-slim AS builder

WORKDIR /app

# Extra CA trust for corporate proxies. Debian base avoids the alpine
# chicken/egg where apk can't reach its mirrors until the cert is trusted.
# The certs/ directory is gitignored — empty in CI, populated locally.
COPY deploy/certs/ /usr/local/share/ca-certificates/redsim-extra/
RUN apt-get update && apt-get install -y --no-install-recommends \
        ca-certificates \
    && find /usr/local/share/ca-certificates/redsim-extra/ -type f \( -name "*.pem" -o -name "*.crt" \) \
         -exec sh -c 'cp "$1" "/usr/local/share/ca-certificates/$(basename "${1%.*}").crt"' _ {} \; \
    && update-ca-certificates \
    && rm -rf /var/lib/apt/lists/*

ENV NODE_EXTRA_CA_CERTS=/etc/ssl/certs/ca-certificates.crt

# pnpm installed explicitly: node:25+ images no longer bundle corepack. Pinned to the
# version used in dev so reproducible installs land on the same resolver behaviour.
RUN npm install -g pnpm@10.33.2

# Workspace manifest + lockfile first, for layer cache efficiency. The root
# package.json is a lockfile importer of its own (it carries the lint and
# format toolchain), and --frozen-lockfile validates against every importer it
# finds, so leaving it out fails the install as an outdated lockfile.
COPY pnpm-workspace.yaml pnpm-lock.yaml package.json ./
COPY web/package.json ./web/
COPY packages/design-system/package.json ./packages/design-system/

# Frozen install of the workspace. Both @redsim/web and
# @redsim/design-system land in their workspace locations; design-
# system's source is then copied below.
RUN pnpm install --frozen-lockfile --filter @redsim/web...

# Now the source. Two trees, because the workspace links them.
COPY web/ ./web/
COPY packages/design-system/ ./packages/design-system/

# Next.js embeds browser configuration at build time. The argument has no
# default on purpose: an image built without it would send every browser to
# its own machine. docker-compose.yml passes the local value explicitly and
# the EC2 host build passes the public https origin.
ARG NEXT_PUBLIC_REDSIM_API_URL
RUN test -n "${NEXT_PUBLIC_REDSIM_API_URL}" || { echo "build-arg NEXT_PUBLIC_REDSIM_API_URL is required (the API origin browsers will call)" >&2; exit 1; }
ENV NEXT_PUBLIC_REDSIM_API_URL=${NEXT_PUBLIC_REDSIM_API_URL}

# Off, and set explicitly rather than left unset. web/src/server/trpc/upstream.ts
# gates the fixture module on a literal read of this name compared against "1",
# so an inlined "0" folds the branch away and the module leaves the output with
# it. Unset, the comparison still folds, but nothing in the image records that
# a released build serves no recorded fixtures.
ARG NEXT_PUBLIC_REDSIM_DEV_FIXTURES=0
ENV NEXT_PUBLIC_REDSIM_DEV_FIXTURES=${NEXT_PUBLIC_REDSIM_DEV_FIXTURES}

# web/src/env.js validates at config load, and no runtime value exists yet at
# image-build time, so the builder stage takes the documented escape hatch. It
# relaxes only the required server names, so the client defaults above are
# still validated and inlined. The runtime stage is a fresh FROM and does not
# inherit it, so the schema is live when next start boots. The build itself
# must succeed: `|| true` used to hide a failure as an image with no .next in
# it.
ENV SKIP_ENV_VALIDATION=1
# The image runs the standalone server (web/next.config.mjs opts in on this flag).
ENV NEXT_OUTPUT_STANDALONE=1
RUN pnpm --filter @redsim/web build

# --------------------------------------------------------------------
# Runtime
# --------------------------------------------------------------------
FROM node:26-bookworm-slim
WORKDIR /app

# Copy the entire workspace tree as built. pnpm's symlinks point into
# /app/node_modules, so the on-disk layout from the builder is enough
# to start Next.js — no need to re-resolve packages at run time.
COPY --from=builder /app ./

ENV NODE_ENV=production
EXPOSE 3000

# Start `next` directly via the workspace-local binary symlink. We
# stay in /app/web so Next finds its build output at ./.next; no
# pnpm needed at runtime (the runtime stage doesn't carry the
# corporate CA bundle, so corepack would fail trying to download pnpm).
WORKDIR /app/web
CMD ["./node_modules/.bin/next", "start", "-p", "3000"]
