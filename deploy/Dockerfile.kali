# Phase 3 dev image for the MCP Kali REST shim.
#
# Uses a Debian base + a minimal slice of the Kali tool set (nmap, curl) so
# the contract is exercisable without a 2GB+ Kali image. For production /
# real scanning workloads, swap the FROM to `kalilinux/kali-rolling` and
# `apt install -y kali-tools-top10`. Nikto isn't in Debian trixie repos.
#
# Build context is the repo root (so we can pull both the submodule files
# and the shared deploy/certs/ trust bundle); see docker-compose.yml.

FROM python:3.12-slim

ENV PYTHONDONTWRITEBYTECODE=1 PYTHONUNBUFFERED=1 PIP_NO_CACHE_DIR=1

WORKDIR /app

# Trust corporate proxy CAs (shared with the api/worker images).
COPY deploy/certs/ /usr/local/share/ca-certificates/aegis-extra/
RUN apt-get update && apt-get install -y --no-install-recommends \
        ca-certificates curl nmap \
    && find /usr/local/share/ca-certificates/aegis-extra/ -type f \( -name "*.pem" -o -name "*.crt" \) \
         -exec sh -c 'cp "$1" "/usr/local/share/ca-certificates/$(basename "${1%.*}").crt"' _ {} \; \
    && update-ca-certificates \
    && rm -rf /var/lib/apt/lists/*

ENV REQUESTS_CA_BUNDLE=/etc/ssl/certs/ca-certificates.crt \
    SSL_CERT_FILE=/etc/ssl/certs/ca-certificates.crt \
    PIP_CERT=/etc/ssl/certs/ca-certificates.crt

COPY project_repos/mcp-kali-server/requirements.txt ./
RUN pip install --upgrade pip && pip install -r requirements.txt

COPY project_repos/mcp-kali-server/server.py project_repos/mcp-kali-server/client.py ./

EXPOSE 5000
CMD ["python", "server.py", "--ip", "0.0.0.0", "--port", "5000"]
