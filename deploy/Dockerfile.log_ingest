# aegis-log-ingest — receives OTLP/Logs from the Collector and writes
# the canonical Postgres mirror.
#
# The image is intentionally minimal: just enough Python to run the
# FastAPI app + SQLAlchemy. No CAI / Strix / Trivy.

FROM python:3.14-slim-bookworm

WORKDIR /app

ENV PYTHONUNBUFFERED=1 \
    PIP_NO_CACHE_DIR=1

# Extra CA trust for corporate proxies (same pattern as
# Dockerfile.api / Dockerfile.worker). The certs/ directory is
# gitignored — empty in CI, populated locally for Zscaler.
COPY deploy/certs/ /usr/local/share/ca-certificates/aegis-extra/
RUN apt-get update && apt-get install -y --no-install-recommends \
        ca-certificates \
    && find /usr/local/share/ca-certificates/aegis-extra/ -type f \( -name "*.pem" -o -name "*.crt" \) \
         -exec sh -c 'cp "$1" "/usr/local/share/ca-certificates/$(basename "${1%.*}").crt"' _ {} \; \
    && update-ca-certificates \
    && rm -rf /var/lib/apt/lists/*

ENV SSL_CERT_FILE=/etc/ssl/certs/ca-certificates.crt \
    REQUESTS_CA_BUNDLE=/etc/ssl/certs/ca-certificates.crt

COPY pyproject.toml /app/
COPY aegis /app/aegis

RUN pip install --no-cache-dir ".[api]" \
    && pip install --no-cache-dir uvicorn

EXPOSE 4319

# Bind to 4319 so 4318 (OTLP/HTTP) stays available for the Collector
# itself; the Collector posts to us via the otlphttp/aegis-ingest
# exporter pointing at this port.
CMD ["uvicorn", "aegis.log_ingest.server:app", \
     "--host", "0.0.0.0", "--port", "4319"]
