# Rebuild only the Next.js bundle from a verified CI image, retaining its
# installed workspace/dependencies. BASE_IMAGE must be an immutable digest.
ARG BASE_IMAGE
FROM ${BASE_IMAGE}
ARG NEXT_PUBLIC_REDSIM_API_URL
ENV NEXT_PUBLIC_REDSIM_API_URL=${NEXT_PUBLIC_REDSIM_API_URL}
WORKDIR /app/web
COPY web/src/ ./src/
RUN ./node_modules/.bin/next build
