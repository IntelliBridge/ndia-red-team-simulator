# Non-secret environment overrides for the Python services on the EC2 host,
# layered by redsim-run after /opt/redsim/env/common.env and before the
# Secrets Manager JSON. Committed so a merge to main changes them.
#
# Capacity for the demo host (t3.xlarge, 4 vCPU): the default worker runs four
# probe jobs at once (redsim-default.service), each a garak child that mostly
# waits on the gateway. Keep these in step with that concurrency.
REDSIM_LLM_PROBE_MAX_RUNS_PER_PROJECT_PER_DAY=500
REDSIM_ML_MAX_CONCURRENT_RUNS_PER_PROJECT=4
REDSIM_LLM_PROBE_MAX_PROMPTS_PER_PROBE=64

# Web: the redsim_api_session cookie TTL (default 900 s). The client keeps it
# alive with POST /api/auth/refresh-api-session while a tab is open; one hour
# covers a laptop lid closed over lunch without a forced re-login.
REDSIM_API_SESSION_TTL_SECONDS=3600

# ML sandbox child on the demo host: an open-weights ResNet-18 upload evaluated
# at 224 px (docs/dev/open-weights.md) needs more than the 1200 s / 900 CPU-s /
# 2-thread defaults. The wall clock stays below the Celery soft limit (1800 s)
# and the CPU budget is four threads for that wall clock.
REDSIM_ML_SANDBOX_TIMEOUT_S=1700
REDSIM_ML_SANDBOX_CPU_SECONDS=6800
REDSIM_ML_SANDBOX_THREADS=4
REDSIM_ML_SANDBOX_MEMORY_MB=8192
