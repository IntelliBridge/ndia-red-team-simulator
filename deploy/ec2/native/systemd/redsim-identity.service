[Unit]
Description=redsim identity (Keycloak)
After=network-online.target
Wants=network-online.target
[Service]
Type=simple
User=redsim
Group=redsim
WorkingDirectory=/opt/keycloak
Environment=JAVA_OPTS_KC_HEAP=-Xms512m -Xmx2g
ExecStart=/usr/local/bin/redsim-run identity /opt/keycloak/bin/kc.sh start --import-realm
Restart=always
RestartSec=5
TimeoutStartSec=600
TimeoutStopSec=60
[Install]
WantedBy=multi-user.target
