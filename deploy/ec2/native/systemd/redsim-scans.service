[Unit]
Description=redsim Celery worker (scans queue)
After=network-online.target 
Wants=network-online.target
[Service]
Type=simple
User=redsim
Group=redsim
Environment=HOME=/var/lib/redsim
Environment=COREPACK_ENABLE_DOWNLOAD_PROMPT=0
WorkingDirectory=/opt/redsim/src
ExecStart=/usr/local/bin/redsim-run scans celery -A redsim.workers.celery_app worker -Q scans --concurrency=1 --loglevel=info
Restart=always
RestartSec=3
KillMode=mixed
# A campaign runs up to 35 min (Celery hard limit 2100 s). A stop is a warm
# shutdown: the worker finishes the task in flight, then exits. SIGKILL only after.
TimeoutStopSec=2400
LimitNOFILE=65536
[Install]
WantedBy=multi-user.target
