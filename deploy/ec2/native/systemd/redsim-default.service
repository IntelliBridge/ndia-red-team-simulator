[Unit]
Description=redsim Celery worker (default queue)
After=network-online.target 
Wants=network-online.target
[Service]
Type=simple
User=redsim
Group=redsim
Environment=HOME=/var/lib/redsim
Environment=COREPACK_ENABLE_DOWNLOAD_PROMPT=0
WorkingDirectory=/opt/redsim/src
ExecStart=/usr/local/bin/redsim-run default celery -A redsim.workers.celery_app worker -Q default --concurrency=1 --loglevel=info
Restart=always
RestartSec=3
KillMode=mixed
TimeoutStopSec=60
LimitNOFILE=65536
[Install]
WantedBy=multi-user.target
