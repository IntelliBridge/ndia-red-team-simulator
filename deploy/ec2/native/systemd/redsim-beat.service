[Unit]
Description=redsim Celery beat
After=network-online.target 
Wants=network-online.target
[Service]
Type=simple
User=redsim
Group=redsim
WorkingDirectory=/opt/redsim/src
ExecStart=/usr/local/bin/redsim-run beat celery -A redsim.workers.celery_app beat --schedule=/var/tmp/redsim-ml/celerybeat-schedule --loglevel=info
Restart=always
RestartSec=3
KillMode=mixed
TimeoutStopSec=60
LimitNOFILE=65536
[Install]
WantedBy=multi-user.target
