#!/usr/bin/env bash
#
# Deploy redsim from source on the EC2 host (native processes, no containers).
#
#   redsim-deploy [ref] [--build]
#
# 1. fast-forward /opt/redsim/src to origin/<ref> (default main),
# 2. reinstall only what the diff touched: the venv when pyproject.toml
#    changed (or --build), node modules when the lockfile changed, the realm
#    file when it changed,
# 3. rebuild the web app when its tree changed, then restart the systemd units,
# 4. require /health to answer 200 on the public origin.
set -euo pipefail

REF="main"; BUILD=0
for arg in "$@"; do
  case "$arg" in
    --build) BUILD=1 ;;
    *) REF="$arg" ;;
  esac
done
# shellcheck disable=SC1091
source /opt/redsim/deploy.env
SRC=/opt/redsim/src
VENV=/opt/redsim/venv
ORIGIN="${REDSIM_PUBLIC_ORIGIN:?}"

# Every git command runs as the checkout's owner (the redsim service user):
# root in a redsim-owned repository is "dubious ownership" (exit 128) and
# would leave root-owned files under .git.
g() { sudo -u redsim -H git -C "$SRC" "$@"; }
cd "$SRC"
before="$(g rev-parse HEAD)"
g fetch --quiet origin
target="$(g rev-parse "origin/$REF" 2>/dev/null || g rev-parse "$REF")"
g checkout --quiet --detach "$target"
echo "checkout: ${before:0:7} -> ${target:0:7} ($REF)"
install -m 0755 "$SRC/deploy/ec2/native/redsim-deploy" /usr/local/bin/redsim-deploy
install -m 0755 "$SRC/deploy/ec2/native/redsim-run" /usr/local/bin/redsim-run
changed="$(g diff --name-only "$before" "$target" || true)"

if [ "$BUILD" = 1 ] || grep -qx 'pyproject.toml' <<<"$changed" || ! "$VENV/bin/python" -c 'import garak' 2>/dev/null; then
  # garak is the LLM probe engine (extra `garak`); a venv without it fails every
  # probe run with probe_child_failed: No module named 'garak' (run-3bf693af50f9).
  echo "python dependencies changed or garak missing: reinstalling the venv"
  "$VENV/bin/pip" install --quiet -e ".[api,worker,ml,garak]"
fi
restart_web=0
if grep -qE '^(pnpm-lock.yaml|web/package.json|packages/design-system/package.json)$' <<<"$changed"; then
  echo "web dependencies changed: pnpm install"
  sudo -u redsim -H env CI=true pnpm install --frozen-lockfile
  restart_web=1
fi
# The web app runs as a production build (`next start`), not the dev server: the
# dev server compiled every route on its first request (5 s of HTML on a fresh
# route, several more for the chunks) and served unoptimised bundles, which read
# as the app re-running auth on every tab. Rebuild when the web tree, the design
# system or the lockfile changed, or when no build exists yet. redsim-run web
# supplies the build-time environment (NEXT_PUBLIC_REDSIM_API_URL and the Better
# Auth values env.js validates) exactly as the running server sees it.
if grep -qE '^(web/|packages/design-system/|pnpm-lock.yaml)' <<<"$changed" || [ ! -f "$SRC/web/.next/BUILD_ID" ]; then
  echo "web changed or no build present: next build"
  sudo -u redsim -H env CI=true /usr/local/bin/redsim-run web pnpm --filter @redsim/web build
  restart_web=1
fi
if grep -qE '^deploy/ec2/native/systemd/' <<<"$changed"; then
  install -m 0644 "$SRC"/deploy/ec2/native/systemd/*.service /etc/systemd/system/
  systemctl daemon-reload
  restart_web=1
fi
if grep -qx 'deploy/runtime/identity/realm.json' <<<"$changed"; then
  cp "$SRC/deploy/runtime/identity/realm.json" /opt/keycloak/data/import/redsim-realm.json
  chown redsim:redsim /opt/keycloak/data/import/redsim-realm.json
  systemctl restart redsim-identity
fi
if grep -q '^redsim/db/migrations/' <<<"$changed"; then
  echo "NOTE: migrations changed; run them with the migration credentials (deploy/ec2/README.md)"
fi

# The tenant rows the token claims point at. Memberships live in the Keycloak
# claim (redsim_project_roles -> {"default": "<role>"}), but every audited
# write needs the organisation and project ROWS (audit_events.project_id FK):
# without them POST /v1/auth-profiles and friends answer 500. Idempotent, so it
# runs on every deploy; a database hiccup is a warning, not a failed deploy.
/usr/local/bin/redsim-run api "$VENV/bin/python" "$SRC/deploy/runtime/scripts/seed_project.py" org-default default Default \
  || echo "WARNING: seed_project.py (org-default/default) failed; audited writes will 500 until the rows exist" >&2
systemctl restart redsim-api redsim-scans redsim-default redsim-beat
[ "$restart_web" = 1 ] && systemctl restart redsim-web
systemctl --no-pager --plain list-units 'redsim-*' caddy | awk 'NR>1 && $1 ~ /service/ {print $1, $3, $4}'

for _ in $(seq 1 30); do
  code="$(curl -s -o /dev/null -w '%{http_code}' --max-time 10 "${ORIGIN}/health" || true)"
  [ "$code" = "200" ] && { echo "deployed ${target:0:7}: ${ORIGIN}/health 200"; exit 0; }
  sleep 3
done
echo "health check failed after the deploy (last code: $code)" >&2
journalctl -u redsim-api -n 30 --no-pager
exit 1
