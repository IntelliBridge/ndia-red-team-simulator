#!/usr/bin/env python3
"""Launch one redsim process with its environment assembled from files.

    redsim-run <service> <command...>

Reads, in order, ``/opt/redsim/env/common.env`` (KEY=VALUE lines) for the
Python services or ``<service>.env`` for web and identity, then the
Secrets Manager JSON ``/opt/redsim/env/<service>.json`` (and ``pythia.json``
for the workers when present), and execs the command with that environment.
JSON keeps multi-line PEM values intact, which systemd EnvironmentFile
cannot. Secrets never touch the command line or the journal.
"""
import json
import os
import sys
from pathlib import Path

ENV_DIR = Path("/opt/redsim/env")
PYTHON_SERVICES = {"api", "scans", "default", "beat"}
WORKERS = {"scans", "default"}


def read_env_file(path: Path) -> dict[str, str]:
    values: dict[str, str] = {}
    if not path.is_file():
        return values
    for line in path.read_text().splitlines():
        line = line.strip()
        if not line or line.startswith("#") or "=" not in line:
            continue
        key, _, value = line.partition("=")
        values[key.strip()] = value.strip()
    return values


def main(argv: list[str]) -> int:
    if len(argv) < 2:
        print("usage: redsim-run <service> <command...>", file=sys.stderr)
        return 2
    service, command = argv[0], argv[1:]
    env = dict(os.environ)
    env.update(read_env_file(ENV_DIR / ("common.env" if service in PYTHON_SERVICES else f"{service}.env")))
    for name in ([service] + (["pythia"] if service in WORKERS else [])):
        path = ENV_DIR / f"{name}.json"
        if path.is_file():
            env.update({k: str(v) for k, v in json.loads(path.read_text()).items()})
    if service in PYTHON_SERVICES:
        env.setdefault("PATH", "")
        env["PATH"] = "/opt/redsim/venv/bin:" + env["PATH"]
        if service in WORKERS and env.get("PYTHIA_API_KEY"):
            env["REDSIM_DISABLE_LLM"] = "0"
    os.execvpe(command[0], command, env)
    return 1


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
