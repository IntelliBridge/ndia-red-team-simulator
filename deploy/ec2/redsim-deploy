#!/usr/bin/env bash
#
# Deploy redsim from source on the EC2 host (installed as /usr/local/bin/redsim-deploy).
#
#   redsim-deploy [ref] [--build]
#
# 1. fast-forward the checkout in /opt/redsim/src to origin/<ref> (default main),
# 2. re-render the environment from Secrets Manager (redsim-render-env), then
#    restart the Python containers, which bind-mount the checkout, so the new
#    code is live in seconds; the web dev server reloads on its own,
# 3. when pyproject.toml, a Dockerfile or the lockfile changed (or --build was
#    given), rebuild what depends on it first,
# 4. require /health to answer 200.
#
# Reads /opt/redsim/deploy.env for REDSIM_HOST_DIR, REDSIM_SRC_DIR,
# REDSIM_BASE_TAG, REDSIM_REGISTRY, REDSIM_PUBLIC_ORIGIN.
set -euo pipefail

REF="main"; BUILD=0
for arg in "$@"; do
  case "$arg" in
    --build) BUILD=1 ;;
    *) REF="$arg" ;;
  esac
done
# shellcheck disable=SC1091
source /opt/redsim/deploy.env
export REDSIM_HOST_DIR REDSIM_SRC_DIR REDSIM_BASE_TAG REDSIM_REGISTRY REDSIM_PUBLIC_ORIGIN
COMPOSE=(docker compose -f "$REDSIM_SRC_DIR/deploy/ec2/compose.host.yml" --project-directory "$REDSIM_HOST_DIR")

cd "$REDSIM_SRC_DIR"
before="$(git rev-parse HEAD)"
git fetch --quiet origin
target="$(git rev-parse "origin/$REF" 2>/dev/null || git rev-parse "$REF")"
git checkout --quiet --detach "$target"
echo "checkout: ${before:0:7} -> ${target:0:7} ($REF)"
# The next run uses the script version that was just checked out.
install -m 0755 "$REDSIM_SRC_DIR/deploy/ec2/redsim-deploy" /usr/local/bin/redsim-deploy
# Re-render the environment from Secrets Manager (service secrets, pythia.env and
# llm.env with REDSIM_DISABLE_LLM / REDSIM_TARGET_ALLOWLIST) so a new or rotated
# secret lands on this deploy. The script is the checkout's; install it too.
install -m 0755 "$REDSIM_SRC_DIR/deploy/ec2/redsim-render-env.sh" /usr/local/bin/redsim-render-env
REDSIM_ENV_DIR="$REDSIM_HOST_DIR/env" /usr/local/bin/redsim-render-env
# The flag now comes from llm.env; drop the copy an older bootstrap left in common.env.
sed -i '/^REDSIM_DISABLE_LLM=/d' "$REDSIM_HOST_DIR/env/common.env"

changed="$(git diff --name-only "$before" "$target" || true)"
if [ "$BUILD" = 1 ] || grep -qE '^(pyproject.toml|deploy/Dockerfile\.(api|worker|identity)|deploy/runtime/identity/realm.json)$' <<<"$changed"; then
  echo "dependencies or images changed: building api, worker and identity images on the host"
  /usr/local/bin/redsim-ecr-login >/dev/null
  docker build -q -f deploy/Dockerfile.api -t "${REDSIM_REGISTRY}/api:${REDSIM_BASE_TAG}" . >/dev/null
  docker build -q -f deploy/Dockerfile.worker -t "${REDSIM_REGISTRY}/worker:${REDSIM_BASE_TAG}" . >/dev/null
  "${COMPOSE[@]}" build identity
fi

if grep -qE '^(pnpm-lock.yaml|web/package.json|packages/design-system/package.json)$' <<<"$changed"; then
  echo "web dependencies changed: restarting the dev server (pnpm install runs on start)"
  "${COMPOSE[@]}" up -d --force-recreate web
fi

if grep -q '^redsim/db/migrations/' <<<"$changed"; then
  echo "NOTE: migrations changed; run them with the migration credentials (deploy/ec2/README.md)"
fi

"${COMPOSE[@]}" up -d --force-recreate api scans default beat
"${COMPOSE[@]}" up -d
"${COMPOSE[@]}" ps --format '{{.Name}} {{.Status}}'

for _ in $(seq 1 30); do
  code="$(curl -s -o /dev/null -w '%{http_code}' --max-time 10 "${REDSIM_PUBLIC_ORIGIN}/health" || true)"
  [ "$code" = "200" ] && { echo "deployed ${target:0:7}: ${REDSIM_PUBLIC_ORIGIN}/health 200"; exit 0; }
  sleep 5
done
echo "health check failed after the deploy (last code: $code)" >&2
"${COMPOSE[@]}" logs --tail 30 api
exit 1
