# Review-only template. Do not install under .github/workflows until the CI
# owner approves its scope. It has no cloud credentials or deployment actions.
name: P7 infrastructure checks

on:
  pull_request:
    paths:
      - "deploy/terraform/**"
      - ".github/workflows/p7-infra-checks.yml"

permissions:
  contents: read

concurrency:
  group: p7-infra-${{ github.event.pull_request.number }}
  cancel-in-progress: true

jobs:
  foundation:
    name: Credential-free foundation validation
    runs-on: ubuntu-latest
    timeout-minutes: 15
    steps:
      - uses: actions/checkout@3d3c42e5aac5ba805825da76410c181273ba90b1 # v7
        with:
          persist-credentials: false
      - uses: actions/setup-python@5fda3b95a4ea91299a34e894583c3862153e4b97 # v7
        with:
          python-version: "3.12"
      - uses: hashicorp/setup-terraform@b9cd54a3c349d3f38e8881555d616ced269862dd # v3
        with:
          terraform_version: "1.16.1"
          terraform_wrapper: false
      - name: Check source and mocked plans
        working-directory: deploy/terraform
        run: ./validate.sh