{
  "name": "redsim-workspace",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.33.2",
  "scripts": {
    "lint": "eslint",
    "lint:fix": "eslint --fix",
    "format:check": "prettier --check \"**/*.{js,mjs,cjs,ts,tsx,json,css,md,yml,yaml}\"",
    "format:write": "prettier --write \"**/*.{js,mjs,cjs,ts,tsx,json,css,md,yml,yaml}\"",
    "typecheck": "pnpm -r run typecheck",
    "check": "pnpm run lint && pnpm run typecheck"
  },
  "devDependencies": {
    "eslint": "^10.10.0",
    "eslint-config-next": "^16.3.4",
    "prettier": "^3.9.6",
    "prettier-plugin-tailwindcss": "^0.7.1",
    "typescript": "^5.4.0",
    "typescript-eslint": "^8.70.0"
  }
}
