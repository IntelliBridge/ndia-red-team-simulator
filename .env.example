# Aegis environment configuration — copy to .env and fill in.
# Anything left blank uses the default documented in aegis/config.py.

# ---- Mode ------------------------------------------------------------------
# Phase 3 CLI is offline by default. Setting AEGIS_MODE=api or passing --api on
# the CLI routes commands through AEGIS_API_URL. Setting AEGIS_API_URL alone
# does NOT change CLI behavior.
AEGIS_MODE=filesystem
AEGIS_API_URL=

# ---- Database (Phase 3 / API mode) ----------------------------------------
# When unset the CLI uses filesystem-backed RunState.
AEGIS_DB_URL=postgresql+psycopg://aegis:aegis@localhost:5432/aegis

# ---- Object storage backend (Phase 3 M9) -----------------------------------
# fs | s3
AEGIS_BLOB_BACKEND=fs
AEGIS_S3_ENDPOINT=
AEGIS_S3_BUCKET=
AEGIS_S3_ACCESS_KEY_ID=
AEGIS_S3_SECRET_ACCESS_KEY=
AEGIS_S3_REGION=us-east-1

# ---- Authentication (Phase 3 M3) ------------------------------------------
# dev | oidc. dev accepts `Bearer dev:<email>` mapped to a seeded admin.
# Hard-fails in production (AEGIS_ENV=prod).
AEGIS_AUTH_MODE=dev
AEGIS_ENV=dev

AEGIS_OIDC_ISSUER=
AEGIS_OIDC_AUDIENCE=aegis
AEGIS_OIDC_JWKS_URL=

# Worker→API service-account signing key. Generate with `openssl rand -hex 32`.
# REQUIRED for worker auth: the legacy non-expiring `worker:<hex>` token is gone,
# so without this key workers cannot authenticate to the API.
AEGIS_WORKER_SIGNING_KEY=

# ---- Key rotation ---------------------------------------------------------
# JWKS cache TTL (seconds): how long the API caches the IdP's signing keys
# before refetching, so a rotated/revoked Keycloak key is picked up without a
# restart. Default 300.
AEGIS_API_JWKS_CACHE_TTL_SECONDS=300
# Previous API-session public key, accepted alongside the current one during a
# cookie-signing-key rotation (graceful dual-key window). Unset outside rotation.
AEGIS_API_SESSION_PUBLIC_KEY_PREVIOUS=
# Previous DAST auth-profile Fernet key, accepted via MultiFernet during a
# key rotation so existing profiles decrypt without re-creation. Unset normally.
AEGIS_AUTH_PROFILES_KEY_PREVIOUS=

# ---- CORS (Phase 3 M3) ----------------------------------------------------
AEGIS_CORS_ORIGINS=http://localhost:3000

# ---- LLM budget -----------------------------------------------------------
# Fail-closed budget enforcement: a DB-backed run that reaches an LLM call
# without a budget checker is DENIED. Default True in prod (AEGIS_ENV=prod);
# set 0 to allow ungoverned LLM calls (not recommended outside dev).
AEGIS_LLM_BUDGET_STRICT=

# ---- LLM provider (Phase 2) -----------------------------------------------
# Only the active provider's key needs to be set.
GOOGLE_API_KEY=
GEMINI_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
AZURE_API_KEY=
AZURE_OPENAI_API_KEY=

# ---- GitHub App (Phase 3 M7) ----------------------------------------------
AEGIS_GITHUB_APP_ID=
AEGIS_GITHUB_APP_PRIVATE_KEY_PATH=/etc/aegis/github_app.pem
AEGIS_GITHUB_WEBHOOK_SECRET=

# Phase 2 fallback: `gh` CLI auth.
GITHUB_TOKEN=

# ---- Workers + queue (Phase 3 M5) -----------------------------------------
AEGIS_BROKER_URL=redis://localhost:6379/0
AEGIS_RESULT_BACKEND=redis://localhost:6379/1

# ---- Kali / mcp-kali-server (Phase 2; compose service in Phase 3 M12) -----
AEGIS_KALI_URL=http://127.0.0.1:5000
AEGIS_KALI_ALLOW_GENERIC_COMMAND=

# ---- Observability (Phase 3 M10) ------------------------------------------
OTEL_EXPORTER_OTLP_ENDPOINT=
OTEL_SERVICE_NAME=aegis-api

# ---- Plugin sandbox -------------------------------------------------------
# Third-party plugin scanners run out-of-process by default (set 0 to disable).
# Defense-in-depth: process isolation + a minimal allowlisted env (parent
# secrets are never passed to plugin code) + POSIX rlimits + own process group
# with group-kill on timeout. This is NOT a network or filesystem jail — a
# hostile plugin can still reach sockets/files the worker UID can; only run
# vetted, signed plugins. Kernel-level isolation is ADR-0006.
AEGIS_PLUGINS_SANDBOX=1
# Sandbox resource limits (rlimits applied to the plugin child process):
AEGIS_PLUGIN_SANDBOX_NETWORK=0
AEGIS_PLUGIN_SANDBOX_CPU_SECONDS=300
AEGIS_PLUGIN_SANDBOX_MEMORY_MB=1024
AEGIS_PLUGIN_SANDBOX_FILESIZE_MB=256

# ---- Iterative remediation (opt-in) ---------------------------------------
# Command the fix→test→retry loop runs to validate a generated fix (e.g.
# `pytest -q`). Unset disables the loop. The loop refuses a dirty working tree
# and scrubs fed-back test output for secrets before it reaches the LLM.
AEGIS_REMEDIATION_TEST_COMMAND=
# Max fix→test→retry iterations. Default 3.
AEGIS_REMEDIATION_MAX_ITERS=3

# ---- Demo / test overrides ------------------------------------------------
AEGIS_DISABLE_LLM=
AEGIS_E2E=
AEGIS_E2E_LIVE=
AEGIS_PLUGINS=
