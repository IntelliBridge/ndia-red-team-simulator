# Redsim environment configuration — copy to .env and fill in.
# Anything left blank uses the default documented in redsim/config.py or, for
# the adversarial-ML variables, in the spec (docs/superpowers/specs, section 20.3).
# There are no model-provider keys anywhere in this file (D5): the only LLM
# credential redsim holds is PYTHIA_API_KEY.

# ---- Mode ------------------------------------------------------------------
# Phase 3 CLI is offline by default. Setting REDSIM_MODE=api or passing --api on
# the CLI routes commands through REDSIM_API_URL. Setting REDSIM_API_URL alone
# does NOT change CLI behavior.
REDSIM_MODE=filesystem
REDSIM_API_URL=

# ---- Database (Phase 3 / API mode) ----------------------------------------
# When unset the CLI uses filesystem-backed RunState.
REDSIM_DB_URL=postgresql+psycopg://redsim:redsim@localhost:5432/redsim

# ---- Object storage backend (Phase 3 M9) -----------------------------------
# fs | s3
REDSIM_BLOB_BACKEND=fs
REDSIM_S3_ENDPOINT=
REDSIM_S3_BUCKET=
REDSIM_S3_ACCESS_KEY_ID=
REDSIM_S3_SECRET_ACCESS_KEY=
REDSIM_S3_REGION=us-east-1

# ---- Authentication (Phase 3 M3) ------------------------------------------
# dev | oidc. dev accepts `Bearer dev:<email>` mapped to a seeded admin.
# Hard-fails in production (REDSIM_ENV=prod).
REDSIM_AUTH_MODE=dev
REDSIM_ENV=dev

REDSIM_OIDC_ISSUER=
REDSIM_OIDC_AUDIENCE=redsim
REDSIM_OIDC_JWKS_URL=

# Worker→API service-account signing key. Generate with `openssl rand -hex 32`.
# REQUIRED for worker auth: the legacy non-expiring `worker:<hex>` token is gone,
# so without this key workers cannot authenticate to the API.
REDSIM_WORKER_SIGNING_KEY=

# ---- Key rotation ---------------------------------------------------------
# JWKS cache TTL (seconds): how long the API caches the IdP's signing keys
# before refetching, so a rotated/revoked Keycloak key is picked up without a
# restart. Default 300.
REDSIM_API_JWKS_CACHE_TTL_SECONDS=300
# Previous API-session public key, accepted alongside the current one during a
# cookie-signing-key rotation (graceful dual-key window). Unset outside rotation.
REDSIM_API_SESSION_PUBLIC_KEY_PREVIOUS=
# Previous DAST auth-profile Fernet key, accepted via MultiFernet during a
# key rotation so existing profiles decrypt without re-creation. Unset normally.
REDSIM_AUTH_PROFILES_KEY_PREVIOUS=

# ---- CORS (Phase 3 M3) ----------------------------------------------------
REDSIM_CORS_ORIGINS=http://localhost:3000

# ---- LLM budget -----------------------------------------------------------
# Fail-closed budget enforcement: a DB-backed run that reaches an LLM call
# without a budget checker is DENIED. Default True in prod (REDSIM_ENV=prod);
# set 0 to allow ungoverned LLM calls (not recommended outside dev).
REDSIM_LLM_BUDGET_STRICT=

# ---- Pythia (LLM gateway, spec 10.8 / 20.3) --------------------------------
# Every LLM call goes through Pythia (redsim/llm/pythia.py). redsim holds no
# provider key. Read on the worker (default pool). If any of the three
# required values (base URL, key, model) is missing the hardening narrative
# is skipped and recommendations render from the rule layer alone.
# Gateway base URL. The client posts to {PYTHIA_BASE_URL}/v1/chat/completions.
PYTHIA_BASE_URL=
# pk_... gateway key, sent as Authorization: Bearer. The only LLM secret.
PYTHIA_API_KEY=
# Optional persona, sent as the X-Pythia-Persona header.
PYTHIA_PERSONA=
# Per-request timeout in seconds (default 60).
PYTHIA_TIMEOUT_S=
# Canonical model id (<vendor>/<model> or pythia/auto) for the hardening narrative;
# seeds config.task_models["ml.harden_narrative"]. Replaces AEGIS_ML_LLM_MODEL / REDSIM_LLM_MODEL.
REDSIM_ML_LLM_MODEL=
# Set 1 to skip the narrative entirely (rules only); the evidence pack reports llm_enabled=false.
REDSIM_DISABLE_LLM=
# Path of the .env file redsim reads for the variables above (default ./.env, then the repo root).
REDSIM_ENV_FILE=

# ---- Adversarial-ML vertical (worker, spec 20.3) ---------------------------
# Bundled asset tree holding MANIFEST.json, weights and evaluation splits (default ./assets).
REDSIM_ML_ASSETS_DIR=
# Root of the per-job sandbox work directories, mode 0700 (default $TMPDIR/redsim-ml/<job_id>).
REDSIM_ML_WORK_DIR=
# Set 1 to keep work directories after a job for debugging (default: removed).
REDSIM_ML_KEEP_WORK_DIR=
# Sandbox child ceilings (spec 9.4). No network switch exists: the ML child never gets network configuration.
# Wall-clock limit for one sandbox child, seconds (default 1200; must stay below the 1800 s Celery soft limit).
REDSIM_ML_SANDBOX_TIMEOUT_S=
# RLIMIT_CPU of the child, seconds (default 900).
REDSIM_ML_SANDBOX_CPU_SECONDS=
# RLIMIT_AS of the child, MB (default 4096).
REDSIM_ML_SANDBOX_MEMORY_MB=
# RLIMIT_FSIZE of the child, MB (default 1024).
REDSIM_ML_SANDBOX_FILESIZE_MB=
# OMP/MKL/OpenBLAS thread pin of the child (default 2).
REDSIM_ML_SANDBOX_THREADS=
# Directory (volume) for the dataset cache used by `redsim ml build-assets` and the loaders (section 11).
REDSIM_ML_DATASET_CACHE=
# API only: hard cap on an uploaded model, MB (default 512); over it returns 413 model_too_large.
REDSIM_ML_UPLOAD_MAX_MB=
# Size above which the full adversarial slice is not retained as an artifact, MB (default 64).
REDSIM_ML_MAX_ADV_ARTIFACT_MB=
# Kaggle API token, used only by a one-off `redsim ml build-assets` to download malicious_phish.csv.
# Never set on the API, web, steady-state worker or beat services; never reaches the sandbox child.
KAGGLE_API_TOKEN=

# ---- Workers + queue (Phase 3 M5) -----------------------------------------
REDSIM_BROKER_URL=redis://localhost:6379/0
REDSIM_RESULT_BACKEND=redis://localhost:6379/1

# ---- Observability (Phase 3 M10) ------------------------------------------
OTEL_EXPORTER_OTLP_ENDPOINT=
OTEL_SERVICE_NAME=redsim-api

# ---- Plugin sandbox -------------------------------------------------------
# Third-party plugin scanners run out-of-process by default (set 0 to disable).
# Defense-in-depth: process isolation + a minimal allowlisted env (parent
# secrets are never passed to plugin code) + POSIX rlimits + own process group
# with group-kill on timeout. This is NOT a network or filesystem jail — a
# hostile plugin can still reach sockets/files the worker UID can; only run
# vetted, signed plugins.
REDSIM_PLUGINS_SANDBOX=1
# Sandbox resource limits (rlimits applied to the plugin child process):
REDSIM_PLUGIN_SANDBOX_NETWORK=0
REDSIM_PLUGIN_SANDBOX_CPU_SECONDS=300
REDSIM_PLUGIN_SANDBOX_MEMORY_MB=1024
REDSIM_PLUGIN_SANDBOX_FILESIZE_MB=256

# ---- Demo / test overrides ------------------------------------------------
REDSIM_E2E=
REDSIM_E2E_LIVE=
REDSIM_PLUGINS=
