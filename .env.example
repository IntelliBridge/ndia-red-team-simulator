# Redsim environment configuration. Copy to .env and fill in what you need.
#
# Every variable the Python services, the CLI and deploy/docker-compose.yml
# read is listed here with an empty value. Empty means "unset": the default
# named in the comment above the line applies. Compose reads this file through
# `make up` (--env-file .env) and its ${VAR:-default} substitutions treat an
# empty value as unset. `set -a; source .env; set +a` exports empty strings
# instead, so for a shell quick start delete the lines you do not set.
#
# There are no model-provider keys anywhere in this file (D5): the only LLM
# credential redsim holds is PYTHIA_API_KEY. The web process has its own list
# in web/.env.example (KEYCLOAK_*, REDSIM_WEB_SESSION_SECRET, the cookie names
# and the NEXT_PUBLIC_* mirrors); the names both sides read appear in both.

# ---- Mode and CLI ----------------------------------------------------------
# filesystem | api. `api` (or --api on the CLI) routes commands through REDSIM_API_URL (default filesystem).
REDSIM_MODE=
# Base URL of the API the CLI talks to in api mode. Setting it alone does not change CLI behaviour.
REDSIM_API_URL=
# Bearer token the CLI sends in api mode; unset reads ~/.config/redsim/token.
REDSIM_TOKEN=
# Path of the YAML config the CLI and services load (default redsim.yaml in the working directory).
REDSIM_CONFIG=
# Run-state and blob root for filesystem mode (default ./redsim_output).
REDSIM_OUTPUT_DIR=
# Internal package mirror for air-gapped installs; overrides offline_vendor_host in redsim.yaml.
REDSIM_OFFLINE_VENDOR_HOST=

# ---- Database ---------------------------------------------------------------
# SQLAlchemy URL of the runtime role, e.g. postgresql+psycopg://redsim:redsim@localhost:5432/redsim.
# Unset: the CLI uses filesystem-backed RunState and the audit chain stays on disk.
REDSIM_DB_URL=
# Schema-owner URL that `alembic upgrade` connects with when role separation is deployed; unset falls back to REDSIM_DB_URL.
REDSIM_DB_OWNER_URL=

# ---- Object storage ---------------------------------------------------------
# fs | s3 (default fs).
REDSIM_BLOB_BACKEND=
# Directory of the fs backend (default redsim_output/blobs).
REDSIM_BLOB_FS_PATH=
# S3 / MinIO endpoint URL for the s3 backend.
REDSIM_S3_ENDPOINT=
# Bucket of the s3 backend.
REDSIM_S3_BUCKET=
# Access key id of the s3 backend.
REDSIM_S3_ACCESS_KEY_ID=
# Secret access key of the s3 backend.
REDSIM_S3_SECRET_ACCESS_KEY=
# Region of the s3 backend and the WORM bucket (default us-east-1).
REDSIM_S3_REGION=

# ---- WORM audit export (beat task redsim.export_chains_to_worm, `redsim audit export`) ----
# Set 1 to enable the export of verified audit chains to an object-locked bucket (default 0).
REDSIM_WORM_EXPORT=
# Seconds between beat exports (default 86400).
REDSIM_WORM_INTERVAL=
# Object-locked bucket the chains are written to (default redsim-worm).
REDSIM_WORM_BUCKET=
# Retention the lock is set with, days (default 2555).
REDSIM_WORM_RETENTION_DAYS=
# Object lock mode, COMPLIANCE | GOVERNANCE (default COMPLIANCE).
REDSIM_WORM_LOCK_MODE=

# ---- Authentication ---------------------------------------------------------
# dev | oidc (default dev). dev accepts `Bearer dev:<email>` mapped to a seeded admin; refused when REDSIM_ENV=prod.
REDSIM_AUTH_MODE=
# dev | prod (default dev). prod refuses dev tokens, the seed module and ungoverned LLM calls.
REDSIM_ENV=
# OIDC issuer the API validates bearer tokens against (compose: http://keycloak:8080/realms/redsim).
REDSIM_OIDC_ISSUER=
# Expected audience claim (default redsim).
REDSIM_OIDC_AUDIENCE=
# JWKS URL of the issuer (compose: http://keycloak:8080/realms/redsim/protocol/openid-connect/certs).
REDSIM_OIDC_JWKS_URL=
# Seconds the API caches the issuer's signing keys before refetching, so a rotated key is picked up without a restart (default 300).
REDSIM_API_JWKS_CACHE_TTL_SECONDS=
# Fernet key that encrypts AuthProfile secrets (endpoint and probe bearer tokens). Without it every profile create fails closed.
# Generate with `python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"`.
REDSIM_AUTH_PROFILES_KEY=
# Previous Fernet key, accepted through MultiFernet during a rotation so existing profiles decrypt. Unset normally.
REDSIM_AUTH_PROFILES_KEY_PREVIOUS=

# ---- API session cookie contract (the web app signs, the API verifies) ----------------
# Operator-supplied RSA keypair; no keypair is committed. `make up` generates deploy/certs/redsim-api-session.{key,pub}
# and exports both halves. Generate by hand with `openssl genpkey -algorithm RSA -pkeyopt rsa_keygen_bits:2048`.
# Public half (PEM, literal \n accepted): the API verifies redsim_api_session with it. Without it every browser call is 401.
REDSIM_API_SESSION_PUBLIC_KEY=
# Private half (PEM): the web process signs the cookie with it. Never needed by the API or the workers.
REDSIM_API_SESSION_PRIVATE_KEY=
# Previous public key, accepted alongside the current one during a cookie-signing-key rotation. Unset outside rotation.
REDSIM_API_SESSION_PUBLIC_KEY_PREVIOUS=
# `kid` stamped on the cookie so a rotation can be told apart (default redsim-api-session-v1).
REDSIM_API_SESSION_KEY_ID=
# Cookie lifetime, seconds (default 900); the web client refreshes it while a tab is open.
REDSIM_API_SESSION_TTL_SECONDS=
# Name of the session cookie (default redsim_api_session).
REDSIM_API_SESSION_COOKIE=
# Name of the CSRF cookie (default redsim_csrf).
REDSIM_CSRF_COOKIE=
# Name of the CSRF header the double-submit check reads (default X-Redsim-CSRF).
REDSIM_CSRF_HEADER=
# Browser-facing origin of the web app, admitted for the WebSocket handshake (default http://localhost:3000; compose http://localhost:3300).
REDSIM_WEB_ORIGIN=
# Comma-separated origins admitted by CORS and the socket handshake (default http://localhost:3000).
REDSIM_CORS_ORIGINS=

# ---- Worker service account -------------------------------------------------
# HMAC key the workers sign their short-lived API tokens with. REQUIRED for worker auth. Generate with `openssl rand -hex 32`.
REDSIM_WORKER_SIGNING_KEY=
# Previous signing key, accepted while the overlap window is open. Unset outside rotation.
REDSIM_WORKER_SIGNING_KEY_PREVIOUS=
# Version stamped on new worker tokens; bump it with the key (default 1).
REDSIM_WORKER_SIGNING_KEY_VERSION=
# Seconds after a rotation during which tokens signed with the previous key are still accepted (default 300).
REDSIM_WORKER_KEY_OVERLAP_SECONDS=
# Lifetime of one worker token, seconds (default 300).
REDSIM_WORKER_TOKEN_TTL_SECONDS=

# ---- Rate limits (write routes) --------------------------------------------
# Mutating requests per minute per principal (default 30); over it 429 rate_limited.
REDSIM_RL_USER_PER_MIN=
# Mutating requests per minute per project (default 120).
REDSIM_RL_PROJECT_PER_MIN=

# ---- Policy engine ----------------------------------------------------------
# static | opa | cedar (default static, the table in redsim/api/policy.py). opa and cedar are the mirrors under deploy/.
REDSIM_POLICY_ENGINE=
# OPA base URL for the opa backend (default http://localhost:8181; compose profile `policy`).
REDSIM_OPA_URL=
# OPA decision path (default /v1/data/redsim/authz).
REDSIM_OPA_PATH=
# Cedar agent base URL for the cedar backend (default http://localhost:8180).
REDSIM_CEDAR_URL=

# ---- Outbound TLS (Pythia, Hugging Face hub, Kaggle, endpoints) -----------------
# Default on: verify against the OS trust store through `truststore`, which is what a corporate proxy root needs. Set 0 to use a bundle instead.
REDSIM_TLS_TRUSTSTORE=
# PEM bundle used when the truststore is off (falls back to SSL_CERT_FILE, then certifi).
REDSIM_CA_BUNDLE=
# Standard OpenSSL bundle path, read after REDSIM_CA_BUNDLE.
SSL_CERT_FILE=

# ---- LLM guardrails and budget (redsim/llm, worker parent) ----------------------------
# Set 0 to switch the prompt and completion guardrails off (default 1).
REDSIM_LLM_GUARDRAILS=
# Set 0 to stop scrubbing PII-shaped strings from text sent to the model (default 1).
REDSIM_LLM_SCRUB_DIFF=
# Set 0 to skip prompt-injection detection on model input (default 1).
REDSIM_LLM_DETECT_INJECTION=
# Set 0 to skip the output filter on completions (default 1).
REDSIM_LLM_FILTER_OUTPUT=
# Injection risk at or above which the call is blocked: low | medium | high (default high).
REDSIM_LLM_INJECTION_BLOCK_RISK=
# Fail-closed budget enforcement: a DB-backed run that reaches an LLM call without a budget checker is denied.
# Default 1 when REDSIM_ENV=prod, else 0; set 0 to allow ungoverned calls (dev only).
REDSIM_LLM_BUDGET_STRICT=

# ---- Pythia (LLM gateway, spec 10.8 / 20.3) --------------------------------
# Every LLM call goes through Pythia (redsim/llm/pythia.py). redsim holds no
# provider key. Read on the worker (default pool). If any of the three
# required values (base URL, key, model) is missing the hardening narrative
# is skipped and recommendations render from the rule layer alone.
# Gateway base URL. The client posts to {PYTHIA_BASE_URL}/v1/chat/completions.
PYTHIA_BASE_URL=
# pk_... gateway key, sent as Authorization: Bearer. The only LLM secret.
PYTHIA_API_KEY=
# Optional persona, sent as the X-Pythia-Persona header.
PYTHIA_PERSONA=
# Per-request timeout in seconds (default 60).
PYTHIA_TIMEOUT_S=
# Canonical model id (<vendor>/<model> or pythia/auto) for the hardening narrative;
# seeds config.task_models["ml.harden_narrative"]. Replaces AEGIS_ML_LLM_MODEL / REDSIM_LLM_MODEL, still read as deprecated aliases.
REDSIM_ML_LLM_MODEL=
# Set 1 to skip the narrative entirely (rules only); the evidence pack reports llm_enabled=false.
REDSIM_DISABLE_LLM=
# The web process reads the same PYTHIA_* names for the finding chat
# (web/src/app/api/chat). Canonical model id the chat sends; its own name
# because the narrative writer and the chat may run different models.
# Default anthropic/claude-opus-5. Documented in web/.env.example as well.
REDSIM_WEB_CHAT_MODEL=
# Comma-separated hosts the egress check admits for endpoint and LLM target
# registration; replaces target_allowlist from redsim.yaml when set. Container
# images ship no redsim.yaml, so deployments name the Pythia gateway host here.
REDSIM_TARGET_ALLOWLIST=
# Path of the .env file redsim reads for the variables above (default ./.env, then the repo root).
REDSIM_ENV_FILE=

# ---- Adversarial-ML vertical (worker, spec 20.3) ---------------------------
# Bundled asset tree holding MANIFEST.json, weights and evaluation splits (default ./assets).
REDSIM_ML_ASSETS_DIR=
# Compose only: host path mounted read-only at /app/assets as REDSIM_ML_ASSETS_DIR (default ./../assets from deploy/).
REDSIM_ML_ASSETS_HOST_DIR=
# Root of the per-job sandbox work directories, mode 0700 (default $TMPDIR/redsim-ml/<job_id>).
REDSIM_ML_WORK_DIR=
# Set 1 to keep work directories after a job for debugging (default: removed).
REDSIM_ML_KEEP_WORK_DIR=
# Sandbox child ceilings (spec 9.4). No network switch exists: the ML child never gets network configuration.
# Wall-clock limit for one sandbox child, seconds (default 1200; must stay below the 1800 s Celery soft limit).
REDSIM_ML_SANDBOX_TIMEOUT_S=
# RLIMIT_CPU of the child, seconds (default 900).
REDSIM_ML_SANDBOX_CPU_SECONDS=
# RLIMIT_AS of the child, MB (default 4096).
REDSIM_ML_SANDBOX_MEMORY_MB=
# RLIMIT_FSIZE of the child, MB (default 1024).
REDSIM_ML_SANDBOX_FILESIZE_MB=
# OMP/MKL/OpenBLAS thread pin of the child (default 2).
REDSIM_ML_SANDBOX_THREADS=
# Directory (volume) for the dataset cache used by `redsim ml build-assets` and the loaders (section 11).
REDSIM_ML_DATASET_CACHE=
# Directory of the SHAP explanation cache (default explain_cache under the job work directory).
REDSIM_ML_EXPLAIN_CACHE=
# Directory holding both DejaVu Sans faces for the PDF report; unset uses the subsets bundled under redsim/ml/pdf_fonts.
REDSIM_PDF_FONT_DIR=
# API only: hard cap on an uploaded model, MB (default 512); over it returns 413 model_too_large.
REDSIM_ML_UPLOAD_MAX_MB=
# Size above which the full adversarial slice is not retained as an artifact, MB (default 64).
REDSIM_ML_MAX_ADV_ARTIFACT_MB=
# Set 1 to make `redsim doctor` treat the ml extra, sandbox launch and assets manifest checks as required (same as --worker-mode).
REDSIM_DOCTOR_WORKER_MODE=
# Offline caches the campaign frame pins for the run when unset: WordNet for word_substitution ...
NLTK_DATA=
# ... and the torch hub cache the resnet18 recipe reads its ImageNet init from.
TORCH_HOME=
# `redsim ml build-assets` only. None of the four is set on the API, web, steady-state worker or beat services; none reaches the sandbox child.
# Hugging Face hub endpoint the image dataset is fetched from (default https://huggingface.co).
HF_ENDPOINT=
# Hub token, sent only when set; the bundled datasets are not gated.
HF_TOKEN=
# Kaggle API token, used to download the malicious-URLs dataset and the military-assets subset; unset falls back to the committed sample (fixture_only).
KAGGLE_API_TOKEN=
# Older Kaggle username and key pair, sent as HTTP basic auth when KAGGLE_API_TOKEN is unset.
KAGGLE_USERNAME=
# Key half of that pair.
KAGGLE_KEY=

# ---- Phase B: endpoint connector (API estimate + worker-parent broker, spec 21 / ENDPOINT-08) ----
# Every value is optional and read from the process environment; the sandbox child receives none of them.
# Outbound requests per second the broker sends one endpoint (default 10).
REDSIM_ML_ENDPOINT_RPS=
# Rows per predict request (default 32 for image targets, 256 for tabular; capped at 1024).
REDSIM_ML_ENDPOINT_BATCH_ROWS=
# Per-request timeout in seconds (default 30; capped at 60).
REDSIM_ML_ENDPOINT_TIMEOUT_S=
# Per-job cap on rows sent to an endpoint (default 500000); the admission estimate refuses 429 query_budget_exceeded above it.
REDSIM_ML_ENDPOINT_MAX_ROWS=
# Per-job cap on predict requests (default 20000); same admission refusal.
REDSIM_ML_ENDPOINT_MAX_REQUESTS=

# ---- Phase B: LLM probes through Pythia (garak, spec 25; API admission + worker probe child) ----
# Upper bound a probe run may ask for per probe (default 64; the request default is 16).
REDSIM_LLM_PROBE_MAX_PROMPTS_PER_PROBE=
# Daily probe-run quota per project (code default 10; compose and the EC2 host default 500); over it 429 llm_probe_quota_exceeded.
REDSIM_LLM_PROBE_MAX_RUNS_PER_PROJECT_PER_DAY=
# Set 1 to admit detector_mode=hf (Hugging Face detector models); default off, 422 probe_detector_unavailable.
REDSIM_LLM_PROBE_HF_DETECTORS=
# Worker only: directory of pre-cached HF detector models the probe child reads with HF_HUB_OFFLINE=1.
REDSIM_LLM_PROBE_HF_CACHE=
# Worker only: wall-clock limit of one probe child, seconds (default 1500; below the Celery soft limit).
REDSIM_LLM_PROBE_TIMEOUT_S=
# Worker only: RLIMIT_CPU of the probe child, seconds.
REDSIM_LLM_PROBE_CPU_SECONDS=
# Worker only: RLIMIT_AS of the probe child, MB.
REDSIM_LLM_PROBE_MEMORY_MB=
# Worker only: RLIMIT_FSIZE of the probe child, MB.
REDSIM_LLM_PROBE_FILESIZE_MB=
# Worker only: RLIMIT_NPROC of the probe child.
REDSIM_LLM_PROBE_MAX_PROCESSES=
# Worker only: attempts the generator makes per prompt on a transport or 429 failure from the gateway (default 8).
REDSIM_LLM_PROBE_TRANSPORT_MAX_TRIES=
# Worker only: longest back-off between those attempts, seconds (default 60).
REDSIM_LLM_PROBE_TRANSPORT_MAX_SLEEP_S=

# ---- Phase B: capacity, batches, bulk upload, consumed datasets (plan 12 BULK-13/-20/-21, spec 27.1) ----
# Concurrent ML campaign jobs per project before a new admission is deferred, not refused (default 2).
REDSIM_ML_MAX_CONCURRENT_RUNS_PER_PROJECT=
# Daily admissions (attack.run) per project; unset = uncapped, over it 429 daily_budget_exceeded.
REDSIM_ML_DAILY_RUN_BUDGET=
# Alias of REDSIM_ML_DAILY_RUN_BUDGET, read when that name is unset.
REDSIM_ML_PROJECT_DAILY_RUN_BUDGET=
# Members a batch campaign may name (default 20); over it 422 batch_too_large.
REDSIM_ML_BATCH_MAX_MEMBERS=
# Files one POST /v1/models/bulk may carry (default 10); over it 422 bulk_too_many_files.
REDSIM_ML_BULK_UPLOAD_MAX_FILES=
# Total bytes of one bulk upload, MB (default 1024); over it 413 bulk_too_large.
REDSIM_ML_BULK_UPLOAD_MAX_MB=
# API only: cap on a consumed dataset upload (Croissant + Parquet), MB (default 256); over it 413 dataset_too_large.
REDSIM_ML_DATASET_UPLOAD_MAX_MB=
# Rows a consumed Parquet slice may hold (default 200000), enforced in the parse child.
REDSIM_ML_DATASET_MAX_ROWS=

# ---- Phase B: Foundry push (spec 27.3; read from the process environment only, never from this file) ----
# Off unless set. The default worker pool is the only process that needs it for the push; the API reads
# it for presence in GET /v1/integrations. No token variable exists: the bearer is an AuthProfile named at push time.
REDSIM_INTEGRATION_FOUNDRY_URL=
# Set 1 to attest the Foundry instance is non-operational (spec 27.3); required before the roster says configured.
REDSIM_INTEGRATION_FOUNDRY_NON_OPERATIONAL=
# Optional default target dataset rid (never a URL).
REDSIM_INTEGRATION_FOUNDRY_DATASET_RID=
# Per-request timeout of the push, seconds (default 30).
REDSIM_INTEGRATION_FOUNDRY_TIMEOUT_S=

# ---- Signed evidence packs (GET /v1/runs/{id}/evidence-pack, `redsim evidence`) ----
# The API signs each pack's manifest with an Ed25519 key when one is configured; without a key the pack
# is written unsigned and says so. Generate with `redsim evidence keygen --out DIR`. Read on the API only.
# Either a path to the private key PEM ...
REDSIM_EVIDENCE_SIGNING_KEY_FILE=
# ... or the PEM text itself (literal \n sequences are accepted). Never both.
REDSIM_EVIDENCE_SIGNING_KEY=

# ---- Workers + queue --------------------------------------------------------
# Celery broker and the run-events channel (default redis://localhost:6379/0).
REDSIM_BROKER_URL=
# Celery result backend (default redis://localhost:6379/1).
REDSIM_RESULT_BACKEND=

# ---- Observability ----------------------------------------------------------
# OTLP collector endpoint for traces and metrics; unset leaves OTel export off (compose profile `obs`).
OTEL_EXPORTER_OTLP_ENDPOINT=
# Service name stamped on spans and shipped logs (default redsim-api on the API, redsim-worker on the workers).
OTEL_SERVICE_NAME=
# Direct-mode redsim-log-ingest endpoint, e.g. http://localhost:4319; unset leaves logs on stdout and OTLP.
REDSIM_LOG_INGEST_URL=
# Log records per shipped batch (default 100).
REDSIM_LOG_INGEST_BATCH_SIZE=
# Seconds between flushes of a partial batch (default 2).
REDSIM_LOG_INGEST_FLUSH_SECONDS=

# ---- Plugins (third-party scanner and attack adapters) --------------------------------
# Set 1 to discover redsim.scanners and redsim.ml.attacks entry points (default off).
REDSIM_PLUGINS=
# Comma-separated plugin names admitted when discovery is on; unset admits every discovered plugin.
REDSIM_PLUGINS_ALLOW=
# Set 1 to refuse any plugin without a valid Ed25519 signature (default from redsim.yaml, off).
REDSIM_PLUGINS_REQUIRE_SIGNATURE=
# Comma-separated Ed25519 public-key PEM files or directories of *.pem that signatures are verified against.
REDSIM_PLUGINS_TRUSTED_KEYS=
# Comma-separated directories searched for <dist>-<version>.sig files (`redsim plugins sign` writes them).
REDSIM_PLUGINS_SIG_DIR=
# Third-party plugin scanners run out-of-process by default (set 0 to disable, default 1).
# Defense-in-depth: process isolation + a minimal allowlisted env (parent
# secrets are never passed to plugin code) + POSIX rlimits + own process group
# with group-kill on timeout. This is NOT a network or filesystem jail: a
# hostile plugin can still reach sockets/files the worker UID can; only run
# vetted, signed plugins.
REDSIM_PLUGINS_SANDBOX=
# Sandbox resource limits (rlimits applied to the plugin child process):
# Set 1 to opt plugin children back into the network (the proxy variables stay in their environment; default 0).
REDSIM_PLUGIN_SANDBOX_NETWORK=
# RLIMIT_CPU of the plugin child, seconds (default 300).
REDSIM_PLUGIN_SANDBOX_CPU_SECONDS=
# RLIMIT_AS of the plugin child, MB (default 1024).
REDSIM_PLUGIN_SANDBOX_MEMORY_MB=
# RLIMIT_FSIZE of the plugin child, MB (default 256).
REDSIM_PLUGIN_SANDBOX_FILESIZE_MB=

# ---- Test and demo overrides (never set on a deployed service) ------------------------
# Set 1 to collect the e2e tier (`pytest -m e2e tests/e2e`, tests/e2e/README.md).
REDSIM_E2E=
# Migrated Postgres URL that adds the RLS lane to the e2e tier; unset skips the lane.
REDSIM_E2E_POSTGRES_URL=
# child | inprocess: run the e2e campaign in the real sandbox child (default) or in process for debugging.
REDSIM_E2E_SANDBOX=
# Set 1 to run the slow live check of the public data repository in tests/ml/test_datasets.py.
REDSIM_PUBLIC_DATA_CHECK=
# `memory` gives the audit helpers an in-memory writer instead of the database or the filesystem chain.
REDSIM_TEST_AUDIT=
