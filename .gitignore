# Redsim runtime artifacts
redsim_output/

# Python
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/
.mypy_cache/
.ruff_cache/

# Virtualenvs
.venv/
venv/
env/

# Coverage
.coverage
.coverage.*
coverage.xml
htmlcov/

# MkDocs build output
site/

# Node.js
node_modules/
*.tsbuildinfo
.next/

# OS / editor
.DS_Store
*.swp
*.swo
.vscode/
.idea/

# Corporate proxy CA bundles — machine/org-specific, never commit.
deploy/certs/*.pem
deploy/certs/*.crt
# The local API session keypair deploy/scripts/with-session-keypair.sh generates.
deploy/certs/redsim-api-session.key
deploy/certs/redsim-api-session.pub

# desloppify local state
.desloppify/
.mypy-baseline.txt

# ML assets (generated by `redsim ml build-assets`): weights, dataset caches, MANIFEST.json.
# Only the README describing the layout is committed.
assets/*
!assets/README.md
data/

# Local secrets (Pythia key etc.) — never commit
.env
.env.local
.env*.local
